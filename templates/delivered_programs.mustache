{{!
    @template local_adminreport/delivered_programs

    Delivered programs view matching Slides 5 & 6 of the reference report.
}}
<div class="delivered-programs-container">
    <!-- Header Title with Date Range -->
    <div class="delivered-header-banner p-3 mb-4 rounded shadow-sm bg-primary text-white d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <h4 class="mb-1 fw-bold">
                <i class="fa fa-graduation-cap me-2" aria-hidden="true"></i>
                {{#str}} delivered_programs_title, local_adminreport {{/str}}
            </h4>
            <div class="small opacity-75">
                {{#str}} period_from_to, local_adminreport, {"from": "{{start_date_formatted}}", "to": "{{end_date_formatted}}"} {{/str}}
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="{{export_url_delivered}}" class="btn btn-sm btn-light text-primary fw-bold">
                <i class="fa fa-file-excel-o me-1 text-success" aria-hidden="true"></i>
                {{#str}} export_excel, local_adminreport {{/str}}
            </a>
        </div>
    </div>

    <!-- Definitions Callout Banner (Slide 5 definitions) -->
    <div class="card mb-4 border-0 shadow-sm executive-card definition-callout-card">
        <div class="card-body p-3">
            <h6 class="fw-bold text-primary mb-2">
                <i class="fa fa-info-circle me-1" aria-hidden="true"></i>
                {{#str}} program_definitions_title, local_adminreport {{/str}}
            </h6>
            <div class="row g-2 fs-7 text-muted">
                <div class="col-12 col-md-6 col-lg-4">
                    <span class="text-success fw-bold">&#10003;</span>
                    <strong>{{#str}} def_dev_title, local_adminreport {{/str}}:</strong>
                    {{#str}} def_dev_desc, local_adminreport {{/str}}
                </div>
                <div class="col-12 col-md-6 col-lg-4">
                    <span class="text-success fw-bold">&#10003;</span>
                    <strong>{{#str}} def_qual_title, local_adminreport {{/str}}:</strong>
                    {{#str}} def_qual_desc, local_adminreport {{/str}}
                </div>
                <div class="col-12 col-md-6 col-lg-4">
                    <span class="text-success fw-bold">&#10003;</span>
                    <strong>{{#str}} def_assist_dip_title, local_adminreport {{/str}}:</strong>
                    {{#str}} def_assist_dip_desc, local_adminreport {{/str}}
                </div>
                <div class="col-12 col-md-6 col-lg-6">
                    <span class="text-success fw-bold">&#10003;</span>
                    <strong>{{#str}} def_qual_prog_title, local_adminreport {{/str}}:</strong>
                    {{#str}} def_qual_prog_desc, local_adminreport {{/str}}
                </div>
                <div class="col-12 col-md-6 col-lg-6">
                    <span class="text-success fw-bold">&#10003;</span>
                    <strong>{{#str}} def_dip_prog_title, local_adminreport {{/str}}:</strong>
                    {{#str}} def_dip_prog_desc, local_adminreport {{/str}}
                </div>
            </div>
        </div>
    </div>

    <!-- 5 Classification Summary Cards (Slide 5 Table 1) -->
    <div class="row g-3 mb-4">
        {{#delivered_classification.cards}}
        <div class="col">
            <div class="card h-100 border-0 shadow-sm executive-card text-center p-3 {{badge}} border-start border-4">
                <div class="small fw-bold text-muted mb-1">{{name}}</div>
                <div class="h3 fw-bold text-primary mb-0">{{runs}} <span class="fs-7 text-muted fw-normal">{{unit}}</span></div>
                <div class="small text-muted">{{trainees}} {{#str}} trainee, local_adminreport {{/str}}</div>
            </div>
        </div>
        {{/delivered_classification.cards}}
    </div>

    <!-- Main Content & Charts Split Grid -->
    <div class="row g-4 mb-4">
        <!-- Left Column: Tables & Trajectory -->
        <div class="col-12 col-xl-7">
            <!-- Table 1: Sector Breakdown (Slide 5 Table 4) -->
            <div class="card mb-4 border-0 shadow-sm executive-card">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="fa fa-pie-chart me-2 text-primary" aria-hidden="true"></i>
                        {{#str}} sectors_summary_title, local_adminreport {{/str}}
                    </h6>
                    <span class="badge bg-light text-dark border">{{start_date_formatted}} &ndash; {{end_date_formatted}}</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle text-center mb-0 executive-table">
                            <thead class="table-light fs-7">
                                <tr>
                                    <th scope="col" class="text-start">{{#str}} metric, local_adminreport {{/str}}</th>
                                    {{#delivered_sectors.sectors}}
                                    <th scope="col">{{name}}</th>
                                    {{/delivered_sectors.sectors}}
                                </tr>
                            </thead>
                            <tbody class="fs-7">
                                <tr>
                                    <td class="text-start fw-bold">{{#str}} courses_count, local_adminreport {{/str}}</td>
                                    {{#delivered_sectors.sectors}}
                                    <td><strong class="text-primary">{{runs}}</strong></td>
                                    {{/delivered_sectors.sectors}}
                                </tr>
                                <tr>
                                    <td class="text-start fw-bold">{{#str}} trainees_number, local_adminreport {{/str}}</td>
                                    {{#delivered_sectors.sectors}}
                                    <td><span class="badge bg-light text-dark border">{{trainees}}</span></td>
                                    {{/delivered_sectors.sectors}}
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Table 2: Corporate Clients Detail (Slide 5 Table 5) -->
            <div class="card mb-4 border-0 shadow-sm executive-card">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="fa fa-building-o me-2 text-primary" aria-hidden="true"></i>
                        {{#str}} corporate_clients_detail_title, local_adminreport {{/str}}
                    </h6>
                    <a href="{{export_url_corporate}}" class="btn btn-sm btn-outline-success">
                        <i class="fa fa-file-excel-o me-1" aria-hidden="true"></i>
                        {{#str}} export_excel, local_adminreport {{/str}}
                    </a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle mb-0 executive-table">
                            <thead class="table-light fs-7">
                                <tr>
                                    <th scope="col">{{#str}} beneficiary_client, local_adminreport {{/str}}</th>
                                    <th scope="col" class="text-center">{{#str}} programs_count, local_adminreport {{/str}}</th>
                                    <th scope="col" class="text-center">{{#str}} trainees_number, local_adminreport {{/str}}</th>
                                </tr>
                            </thead>
                            <tbody class="fs-7">
                                {{#delivered_corporate.rows}}
                                <tr>
                                    <td class="fw-bold">{{company_name}}</td>
                                    <td class="text-center">{{programs_count}}</td>
                                    <td class="text-center"><span class="badge bg-primary">{{trainees_count}}</span></td>
                                </tr>
                                {{/delivered_corporate.rows}}
                                {{^has_delivered_corporate}}
                                <tr>
                                    <td colspan="3" class="text-center text-muted p-3">
                                        {{#str}} no_data_available, local_adminreport {{/str}}
                                    </td>
                                </tr>
                                {{/has_delivered_corporate}}
                            </tbody>
                            {{#has_delivered_corporate}}
                            <tfoot class="table-light fs-7 fw-bold">
                                <tr>
                                    <td>{{#str}} total, local_adminreport {{/str}}</td>
                                    <td class="text-center">{{delivered_corporate.total_programs}}</td>
                                    <td class="text-center"><span class="badge bg-dark">{{delivered_corporate.total_trainees}}</span></td>
                                </tr>
                            </tfoot>
                            {{/has_delivered_corporate}}
                        </table>
                    </div>
                </div>
            </div>

            <!-- Slide 6: 12-Month Annual Trajectory Table (Slide 6 Table 1) -->
            <div class="card mb-4 border-0 shadow-sm executive-card">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0 fw-bold text-dark">
                            <i class="fa fa-line-chart me-2 text-primary" aria-hidden="true"></i>
                            {{#str}} annual_trajectory_title, local_adminreport {{/str}} ({{monthly_trajectory.year}})
                        </h6>
                    </div>
                    <a href="{{export_url_trajectory}}" class="btn btn-sm btn-outline-success">
                        <i class="fa fa-file-excel-o me-1" aria-hidden="true"></i>
                        {{#str}} export_excel, local_adminreport {{/str}}
                    </a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-sm align-middle text-center mb-0 executive-table fs-7">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" rowspan="2" class="align-middle text-start">{{#str}} month, local_adminreport {{/str}}</th>
                                    <th scope="col" colspan="2" class="border-start border-end">{{#str}} monthly_delivered, local_adminreport {{/str}}</th>
                                    <th scope="col" colspan="2">{{#str}} cumulative_trajectory, local_adminreport {{/str}}</th>
                                </tr>
                                <tr>
                                    <th scope="col" class="border-start">{{#str}} programs, local_adminreport {{/str}}</th>
                                    <th scope="col" class="border-end">{{#str}} trainees, local_adminreport {{/str}}</th>
                                    <th scope="col">{{#str}} cumulative_programs, local_adminreport {{/str}}</th>
                                    <th scope="col">{{#str}} cumulative_trainees, local_adminreport {{/str}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#monthly_trajectory.rows}}
                                <tr>
                                    <td class="text-start fw-bold">{{month_name}}</td>
                                    <td class="border-start">{{month_runs}}</td>
                                    <td class="border-end">{{month_trainees}}</td>
                                    <td><strong class="text-primary">{{cumulative_runs}}</strong></td>
                                    <td><span class="badge bg-light text-dark border">{{cumulative_trainees}}</span></td>
                                </tr>
                                {{/monthly_trajectory.rows}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Slide 6: Strategic Partners & Ongoing Programs (Slide 6 Table 3) -->
            <div class="card mb-4 border-0 shadow-sm executive-card">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="fa fa-handshake-o me-2 text-primary" aria-hidden="true"></i>
                        {{#str}} strategic_partners_title, local_adminreport {{/str}}
                    </h6>
                </div>
                <div class="card-body p-3">
                    <div class="row g-2">
                        {{#strategic_partners}}
                        <div class="col-12 col-md-6">
                            <div class="p-2 border rounded bg-light d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-dark fs-7">{{partner_name}}</span>
                                <span class="badge bg-primary">{{programs_count}} {{#str}} programs, local_adminreport {{/str}}</span>
                            </div>
                        </div>
                        {{/strategic_partners}}
                        {{^has_strategic_partners}}
                        <div class="col-12 text-center text-muted p-2">
                            {{#str}} no_data_available, local_adminreport {{/str}}
                        </div>
                        {{/has_strategic_partners}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: The 4 Pie Charts (Slide 5 Right Side) -->
        <div class="col-12 col-xl-5">
            <!-- Chart 1: Programs By Classification Pie -->
            <div class="card mb-4 border-0 shadow-sm executive-card chart-card">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="fa fa-pie-chart me-2 text-primary" aria-hidden="true"></i>
                        {{#str}} chart_programs_by_type_title, local_adminreport {{/str}}
                    </h6>
                </div>
                <div class="card-body">
                    <div id="chart-programs-by-type" style="min-height: 250px;"></div>
                </div>
            </div>

            <!-- Chart 2: Trainees By Classification Pie -->
            <div class="card mb-4 border-0 shadow-sm executive-card chart-card">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="fa fa-pie-chart me-2 text-info" aria-hidden="true"></i>
                        {{#str}} chart_trainees_by_type_title, local_adminreport {{/str}}
                    </h6>
                </div>
                <div class="card-body">
                    <div id="chart-trainees-by-type" style="min-height: 250px;"></div>
                </div>
            </div>

            <!-- Chart 3: Programs By Sector Pie -->
            <div class="card mb-4 border-0 shadow-sm executive-card chart-card">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="fa fa-pie-chart me-2 text-success" aria-hidden="true"></i>
                        {{#str}} chart_programs_by_sector_title, local_adminreport {{/str}}
                    </h6>
                </div>
                <div class="card-body">
                    <div id="chart-programs-by-sector" style="min-height: 250px;"></div>
                </div>
            </div>

            <!-- Chart 4: Trainees By Sector Pie -->
            <div class="card mb-4 border-0 shadow-sm executive-card chart-card">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="fa fa-pie-chart me-2 text-dark" aria-hidden="true"></i>
                        {{#str}} chart_trainees_by_sector_title, local_adminreport {{/str}}
                    </h6>
                </div>
                <div class="card-body">
                    <div id="chart-trainees-by-sector" style="min-height: 250px;"></div>
                </div>
            </div>
        </div>
    </div>
</div>
