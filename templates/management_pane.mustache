{{!
    @template local_adminreport/management_pane

    Management and import pane for runs, course sync, and CSV upload.
}}
<div class="management-pane-container">
    <div class="row g-4 mb-4">
        <!-- Card 1: Course Auto-Sync -->
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm executive-card p-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 bg-primary-subtle text-primary rounded-circle me-3">
                        <i class="fa fa-refresh fa-2x" aria-hidden="true"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold text-dark">{{#str}} sync_courses_title, local_adminreport {{/str}}</h6>
                        <small class="text-muted">{{#str}} sync_courses_desc, local_adminreport {{/str}}</small>
                    </div>
                </div>
                <p class="fs-7 text-muted">
                    {{#str}} sync_courses_explanation, local_adminreport {{/str}}
                </p>
                <div class="mt-auto">
                    <a href="{{sync_courses_url}}" class="btn btn-sm btn-primary w-100">
                        <i class="fa fa-refresh me-1" aria-hidden="true"></i>
                        {{#str}} sync_courses_btn, local_adminreport {{/str}}
                    </a>
                </div>
            </div>
        </div>

        <!-- Card 2: Manage Operational Runs -->
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm executive-card p-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 bg-success-subtle text-success rounded-circle me-3">
                        <i class="fa fa-cogs fa-2x" aria-hidden="true"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold text-dark">{{#str}} runs_management_title, local_adminreport {{/str}}</h6>
                        <small class="text-muted">{{#str}} runs_management_desc, local_adminreport {{/str}}</small>
                    </div>
                </div>
                <p class="fs-7 text-muted">
                    {{#str}} runs_management_explanation, local_adminreport {{/str}}
                </p>
                <div class="mt-auto">
                    <a href="{{runs_manage_url}}" class="btn btn-sm btn-outline-success w-100">
                        <i class="fa fa-list me-1" aria-hidden="true"></i>
                        {{#str}} runs_manage_btn, local_adminreport {{/str}}
                    </a>
                </div>
            </div>
        </div>

        <!-- Card 3: Import Weekly Schedule CSV -->
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm executive-card p-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="p-3 bg-info-subtle text-info rounded-circle me-3">
                        <i class="fa fa-upload fa-2x" aria-hidden="true"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold text-dark">{{#str}} import_schedule_title, local_adminreport {{/str}}</h6>
                        <small class="text-muted">{{#str}} import_schedule_desc, local_adminreport {{/str}}</small>
                    </div>
                </div>
                <p class="fs-7 text-muted">
                    {{#str}} import_schedule_explanation, local_adminreport {{/str}}
                </p>
                <div class="mt-auto d-flex gap-2">
                    <a href="{{import_url}}" class="btn btn-sm btn-outline-info flex-grow-1">
                        <i class="fa fa-upload me-1" aria-hidden="true"></i>
                        {{#str}} import_csv_btn, local_adminreport {{/str}}
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
