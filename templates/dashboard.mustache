{{!
    @template local_adminreport/dashboard

    Master executive management intelligence dashboard with Left-Pane navigation.
}}
<div class="adminreport-dashboard-container">
    <!-- Loading Overlay -->
    <div id="dashboard-loading-overlay" class="d-none">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">{{#str}} loading, core {{/str}}</span>
        </div>
    </div>

    <!-- Header & Period Switcher Bar -->
    <div class="adminreport-header-card p-3 mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h3 class="mb-1 fw-bold text-dark">{{#str}} pluginname, local_adminreport {{/str}}</h3>
            <p class="text-muted small mb-0">{{#str}} dashboard_subtitle, local_adminreport {{/str}}</p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <!-- Period Tabs -->
            <div class="btn-group period-btn-group" role="group">
                <button type="button" class="btn btn-sm btn-primary active period-btn" data-period="week">
                    {{#str}} period_week, local_adminreport {{/str}}
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary period-btn" data-period="month">
                    {{#str}} period_month, local_adminreport {{/str}}
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary period-btn" data-period="annual">
                    {{#str}} period_annual, local_adminreport {{/str}}
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary period-btn" data-period="custom">
                    {{#str}} period_custom, local_adminreport {{/str}}
                </button>
            </div>

            <!-- Print Button -->
            <button type="button" class="btn btn-sm btn-outline-dark" id="btn-print-dashboard">
                <i class="fa fa-print me-1" aria-hidden="true"></i>
                {{#str}} print, local_adminreport {{/str}}
            </button>

            <!-- Runs Management Link -->
            {{#can_manage}}
            <a href="{{runs_manage_url}}" class="btn btn-sm btn-outline-secondary">
                <i class="fa fa-cogs me-1" aria-hidden="true"></i>
                {{#str}} runs, local_adminreport {{/str}}
            </a>
            {{/can_manage}}
        </div>
    </div>

    <!-- Custom Date Controls (Hidden by default) -->
    <div class="card p-3 mb-4 bg-light border-0 shadow-sm d-none" id="custom-date-controls">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label for="custom-start-date" class="form-label small fw-bold">{{#str}} startdate {{/str}}</label>
                <input type="date" id="custom-start-date" class="form-control form-control-sm">
            </div>
            <div class="col-12 col-md-4">
                <label for="custom-end-date" class="form-label small fw-bold">{{#str}} enddate {{/str}}</label>
                <input type="date" id="custom-end-date" class="form-control form-control-sm">
            </div>
            <div class="col-12 col-md-4">
                <button type="button" class="btn btn-sm btn-primary w-100" id="apply-custom-dates">
                    {{#str}} apply_filters, local_adminreport {{/str}}
                </button>
            </div>
        </div>
    </div>

    <!-- Left-Pane Navigation & Content Layout -->
    <div class="row g-3">
        <!-- Left Pane Navigation (Sidebar) -->
        <div class="col-12 col-lg-3 col-xl-2 mb-3">
            <div class="nav flex-column nav-pills executive-left-nav shadow-sm bg-white p-2 rounded" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                <button class="nav-link active text-start py-3 px-3 mb-2" id="v-pills-plans-tab" data-bs-toggle="pill" data-bs-target="#v-pills-plans" type="button" role="tab" aria-controls="v-pills-plans" aria-selected="true">
                    <i class="fa fa-calendar-check-o me-2" aria-hidden="true"></i>
                    {{#str}} nav_weekly_plans, local_adminreport {{/str}}
                </button>
                <button class="nav-link text-start py-3 px-3 mb-2" id="v-pills-delivered-tab" data-bs-toggle="pill" data-bs-target="#v-pills-delivered" type="button" role="tab" aria-controls="v-pills-delivered" aria-selected="false">
                    <i class="fa fa-graduation-cap me-2" aria-hidden="true"></i>
                    {{#str}} nav_delivered_programs, local_adminreport {{/str}}
                </button>
                <button class="nav-link text-start py-3 px-3 mb-2" id="v-pills-trainees-tab" data-bs-toggle="pill" data-bs-target="#v-pills-trainees" type="button" role="tab" aria-controls="v-pills-trainees" aria-selected="false">
                    <i class="fa fa-users me-2" aria-hidden="true"></i>
                    {{#str}} nav_trainees_reports, local_adminreport {{/str}}
                </button>
                <button class="nav-link text-start py-3 px-3" id="v-pills-management-tab" data-bs-toggle="pill" data-bs-target="#v-pills-management" type="button" role="tab" aria-controls="v-pills-management" aria-selected="false">
                    <i class="fa fa-cogs me-2" aria-hidden="true"></i>
                    {{#str}} nav_management, local_adminreport {{/str}}
                </button>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="col-12 col-lg-9 col-xl-10">
            <div class="tab-content" id="v-pills-tabContent">
                <!-- Pane 1: Weekly Plans (Slides 2, 3, 4) -->
                <div class="tab-pane fade show active" id="v-pills-plans" role="tabpanel" aria-labelledby="v-pills-plans-tab" tabindex="0">
                    {{> local_adminreport/weekly_plans }}
                </div>

                <!-- Pane 2: Delivered Programs (Slides 5, 6) -->
                <div class="tab-pane fade" id="v-pills-delivered" role="tabpanel" aria-labelledby="v-pills-delivered-tab" tabindex="0">
                    {{> local_adminreport/delivered_programs }}
                </div>

                <!-- Pane 3: Trainees Reports -->
                <div class="tab-pane fade" id="v-pills-trainees" role="tabpanel" aria-labelledby="v-pills-trainees-tab" tabindex="0">
                    {{> local_adminreport/trainees_pane }}
                </div>

                <!-- Pane 4: Management & Import -->
                <div class="tab-pane fade" id="v-pills-management" role="tabpanel" aria-labelledby="v-pills-management-tab" tabindex="0">
                    {{> local_adminreport/management_pane }}
                </div>
            </div>
        </div>
    </div>
</div>
