{{!
    @template local_adminreport/dashboard

    Main dashboard template for local_adminreport.
}}
<div class="adminreport-dashboard-container">
    <!-- Loading Overlay -->
    <div id="dashboard-loading-overlay" class="d-none">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">{{#str}} loading, core {{/str}}</span>
        </div>
    </div>

    <!-- Header & Period Switcher Bar -->
    <div class="adminreport-header-card p-3 mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h3 class="mb-1 fw-bold text-dark">{{#str}} pluginname, local_adminreport {{/str}}</h3>
            <p class="text-muted small mb-0">{{#str}} dashboard_subtitle, local_adminreport {{/str}}</p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <!-- Period Tabs -->
            <div class="btn-group period-btn-group" role="group">
                <button type="button" class="btn btn-sm btn-primary active period-btn" data-period="week">
                    {{#str}} period_week, local_adminreport {{/str}}
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary period-btn" data-period="month">
                    {{#str}} period_month, local_adminreport {{/str}}
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary period-btn" data-period="annual">
                    {{#str}} period_annual, local_adminreport {{/str}}
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary period-btn" data-period="custom">
                    {{#str}} period_custom, local_adminreport {{/str}}
                </button>
            </div>

            <!-- Print Button -->
            <button type="button" class="btn btn-sm btn-outline-dark" id="btn-print-dashboard">
                <i class="fa fa-print me-1" aria-hidden="true"></i>
                {{#str}} print, local_adminreport {{/str}}
            </button>

            <!-- Runs Management Link -->
            {{#can_manage}}
            <a href="{{{config.wwwroot}}}/local/adminreport/runs.php" class="btn btn-sm btn-outline-secondary">
                <i class="fa fa-cogs me-1" aria-hidden="true"></i>
                {{#str}} runs, local_adminreport {{/str}}
            </a>
            {{/can_manage}}
        </div>
    </div>

    <!-- Custom Date Controls (Hidden by default) -->
    <div class="card p-3 mb-4 bg-light border-0 shadow-sm d-none" id="custom-date-controls">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label for="custom-start-date" class="form-label small fw-bold">{{#str}} startdate {{/str}}</label>
                <input type="date" id="custom-start-date" class="form-control form-control-sm">
            </div>
            <div class="col-12 col-md-4">
                <label for="custom-end-date" class="form-label small fw-bold">{{#str}} enddate {{/str}}</label>
                <input type="date" id="custom-end-date" class="form-control form-control-sm">
            </div>
            <div class="col-12 col-md-4">
                <button type="button" class="btn btn-sm btn-primary w-100" id="apply-custom-dates">
                    {{#str}} apply_filters, local_adminreport {{/str}}
                </button>
            </div>
        </div>
    </div>

    <!-- Filter Toolbar -->
    <div class="adminreport-filter-bar p-3 mb-4">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-3">
                <label for="filter-org" class="form-label small text-muted mb-1">{{#str}} organization, local_adminreport {{/str}}</label>
                <select id="filter-org" class="form-select form-select-sm">
                    <option value="0">{{#str}} all_organizations, local_adminreport {{/str}}</option>
                    {{#organizations}}
                    <option value="{{id}}">{{name}}</option>
                    {{/organizations}}
                </select>
            </div>

            <div class="col-12 col-md-3">
                <label for="filter-type" class="form-label small text-muted mb-1">{{#str}} program_type, local_adminreport {{/str}}</label>
                <select id="filter-type" class="form-select form-select-sm">
                    <option value="0">{{#str}} all_program_types, local_adminreport {{/str}}</option>
                    {{#program_types}}
                    <option value="{{id}}">{{name}}</option>
                    {{/program_types}}
                </select>
            </div>

            <div class="col-12 col-md-3">
                <label for="filter-location" class="form-label small text-muted mb-1">{{#str}} location, local_adminreport {{/str}}</label>
                <select id="filter-location" class="form-select form-select-sm">
                    <option value="0">{{#str}} all_locations, local_adminreport {{/str}}</option>
                    {{#locations}}
                    <option value="{{id}}">{{name}}</option>
                    {{/locations}}
                </select>
            </div>

            <div class="col-12 col-md-3 d-flex align-items-end">
                <button type="button" class="btn btn-sm btn-outline-secondary w-100 mt-md-4" id="btn-reset-filters">
                    <i class="fa fa-refresh me-1" aria-hidden="true"></i>
                    {{#str}} reset_filters, local_adminreport {{/str}}
                </button>
            </div>
        </div>
    </div>

    <!-- Early Warning Alert Banner -->
    <div id="early-warning-banner" class="alert alert-warning-executive p-3 mb-4 d-flex align-items-center gap-3 {{^total_at_risk}}d-none{{/total_at_risk}}">
        <i class="fa fa-exclamation-triangle fa-2x text-warning" aria-hidden="true"></i>
        <div>
            <h6 class="mb-0 fw-bold">{{#str}} early_warning, local_adminreport {{/str}}</h6>
            <span class="small">
                {{#str}} at_risk_alert_msg, local_adminreport, <strong id="early-warning-count">{{total_at_risk}}</strong> {{/str}}
            </span>
        </div>
    </div>

    <!-- KPI Cards Component -->
    {{> local_adminreport/kpi_cards }}

    <!-- Charts Grid -->
    <div class="row g-3 mb-4">
        <!-- Chart 1: Locations Distribution -->
        <div class="col-12 col-lg-4">
            <div class="chart-card">
                <div class="chart-card-header d-flex justify-content-between align-items-center">
                    <span>{{#str}} chart_locations_title, local_adminreport {{/str}}</span>
                    <i class="fa fa-pie-chart text-muted" aria-hidden="true"></i>
                </div>
                <div class="chart-card-body">
                    <div id="chart-locations-container" style="min-height: 320px;"></div>
                </div>
            </div>
        </div>

        <!-- Chart 2: Program Classifications -->
        <div class="col-12 col-lg-4">
            <div class="chart-card">
                <div class="chart-card-header d-flex justify-content-between align-items-center">
                    <span>{{#str}} chart_classifications_title, local_adminreport {{/str}}</span>
                    <i class="fa fa-bar-chart text-muted" aria-hidden="true"></i>
                </div>
                <div class="chart-card-body">
                    <div id="chart-classifications-container" style="min-height: 320px;"></div>
                </div>
            </div>
        </div>

        <!-- Chart 3: Historical Trends -->
        <div class="col-12 col-lg-4">
            <div class="chart-card">
                <div class="chart-card-header d-flex justify-content-between align-items-center">
                    <span>{{#str}} chart_trends_title, local_adminreport {{/str}}</span>
                    <i class="fa fa-line-chart text-muted" aria-hidden="true"></i>
                </div>
                <div class="chart-card-body">
                    <div id="chart-trends-container" style="min-height: 320px;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Operational Schedule Table Component -->
    {{> local_adminreport/operational_table }}
</div>
