{{!
    @template local_adminreport/trainees_pane

    Trainees reports view for individual learner tracking.
}}
<div class="trainees-pane-container">
    <!-- Early Warning Banner -->
    {{#total_at_risk}}
    <div class="alert alert-warning-executive p-3 mb-4 d-flex align-items-center gap-3">
        <i class="fa fa-exclamation-triangle fa-2x text-warning" aria-hidden="true"></i>
        <div>
            <h6 class="mb-0 fw-bold">{{#str}} early_warning, local_adminreport {{/str}}</h6>
            <span class="small">
                {{#str}} at_risk_alert_msg, local_adminreport, <strong>{{total_at_risk}}</strong> {{/str}}
            </span>
        </div>
    </div>
    {{/total_at_risk}}

    <div class="card border-0 shadow-sm executive-card">
        <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h5 class="mb-0 fw-bold text-dark">
                    <i class="fa fa-users me-2 text-primary" aria-hidden="true"></i>
                    {{#str}} trainees_report_title, local_adminreport {{/str}}
                </h5>
                <small class="text-muted">{{trainees_count}} {{#str}} trainee, local_adminreport {{/str}}</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="input-group input-group-sm" style="max-width: 260px;">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="fa fa-search text-muted" aria-hidden="true"></i>
                    </span>
                    <input type="text" id="trainees-search-input" class="form-control form-control-sm border-start-0" placeholder="{{#str}} search {{/str}}...">
                </div>
                <a href="{{export_url_trainees}}" class="btn btn-sm btn-outline-success">
                    <i class="fa fa-file-excel-o me-1" aria-hidden="true"></i>
                    {{#str}} export_excel, local_adminreport {{/str}}
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0 executive-table" id="trainees-report-table">
                    <thead class="table-light fs-7">
                        <tr>
                            <th scope="col">{{#str}} trainee_name, local_adminreport {{/str}}</th>
                            <th scope="col">{{#str}} idnumber, local_adminreport {{/str}}</th>
                            <th scope="col">{{#str}} email, local_adminreport {{/str}}</th>
                            <th scope="col">{{#str}} company, local_adminreport {{/str}}</th>
                            <th scope="col">{{#str}} course, local_adminreport {{/str}}</th>
                            <th scope="col">{{#str}} run_code, local_adminreport {{/str}}</th>
                            <th scope="col">{{#str}} branch, local_adminreport {{/str}}</th>
                            <th scope="col" class="text-center">{{#str}} status, local_adminreport {{/str}}</th>
                        </tr>
                    </thead>
                    <tbody class="fs-7">
                        {{#trainees_report}}
                        <tr>
                            <td class="fw-bold">{{fullname}}</td>
                            <td><code>{{idnumber}}</code></td>
                            <td><small class="text-muted">{{email}}</small></td>
                            <td>{{orgname}}</td>
                            <td>
                                <a href="{{{config.wwwroot}}}/course/view.php?id={{courseid}}" class="text-decoration-none">
                                    {{coursename}}
                                </a>
                            </td>
                            <td><code>{{run_code}}</code></td>
                            <td>{{locname}}</td>
                            <td class="text-center"><span class="badge {{badge_class}}">{{status_label}}</span></td>
                        </tr>
                        {{/trainees_report}}
                        {{^has_trainees_report}}
                        <tr>
                            <td colspan="8" class="text-center text-muted p-4">
                                {{#str}} no_trainees_found, local_adminreport {{/str}}
                            </td>
                        </tr>
                        {{/has_trainees_report}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
